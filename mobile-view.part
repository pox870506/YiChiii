 const day=draft.days.find(d=>d.date===selected)!;
 const index=draft.days.findIndex(d=>d.date===selected);
 const foodCity=selected==='2026-11-13'?'杜塞道夫':selected==='2026-11-17'?'鹿特丹':selected==='2026-11-20'||selected==='2026-11-22'||selected==='2026-11-23'?'阿姆斯特丹':day.city;
 return <main className="travel-shell"><header className="masthead"><div><p className="eyebrow">2026 / 11.12 — 11.25</p><h1>德荷旅遊手冊</h1><p className="travelers">我 · 耘欣 · 靖宜 · 靖枝 · 玉穎</p><p className="muted">5 位旅人 · 杜塞道夫 4 晚 → 鹿特丹 3 晚 → 阿姆斯特丹 3 晚</p></div><figure><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/09/Amsterdam_Canal_with_boat.jpg/1280px-Amsterdam_Canal_with_boat.jpg" alt="阿姆斯特丹運河" width="4032" height="3024"/><figcaption><a href="https://commons.wikimedia.org/wiki/File:Amsterdam_Canal_with_boat.jpg" target="_blank" rel="noreferrer">Deavmi / Wikimedia</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noreferrer">CC BY-SA 4.0</a> · 裁切</figcaption></figure></header>
 <Tabs defaultValue="plan"><TabsList className="main-tabs" variant="line"><TabsTrigger value="plan">每日行程</TabsTrigger><TabsTrigger value="flights">航班・展會</TabsTrigger><TabsTrigger value="stays">住宿・共編</TabsTrigger><TabsTrigger value="guide">城市美食</TabsTrigger><TabsTrigger value="weather">荷蘭天氣</TabsTrigger><TabsTrigger value="budget">每人預算</TabsTrigger></TabsList>
 <TabsContent value="plan"><div className="date-picker" ref={dateBarRef}><label id="date-label">查看日期</label><Select value={selected} onValueChange={v=>{if(v)chooseDay(v)}}><SelectTrigger aria-labelledby="date-label"><SelectValue>{day.date.slice(5).replace('-','/')} · {day.city}</SelectValue></SelectTrigger><SelectContent>{draft.days.map(d=><SelectItem key={d.date} value={d.date}>{d.date.slice(5).replace('-','/')} · {d.city}</SelectItem>)}</SelectContent></Select><div className="date-arrows"><Button variant="outline" disabled={index===0} onClick={()=>chooseDay(draft.days[index-1].date)}>← 前一天</Button><Button variant="outline" disabled={index===draft.days.length-1} onClick={()=>chooseDay(draft.days[index+1].date)}>後一天 →</Button></div></div><section key={selected} className="day-detail" aria-label="當日行程"><p className="eyebrow">{selected} · {new Date(selected+'T12:00:00').toLocaleDateString('zh-TW',{weekday:'long'})}</p><h2>{day.title}</h2><p className="stay-tag">{day.stay?`今晚：${draft.stays.find(s=>s.city===day.stay)?.name||day.stay}`:'飛行／返程日'}</p>{selected==='2026-11-17'&&<aside className="deadline"><strong>22:00 入住截止 · 目標 20:00 前到房源</strong><p>13:30 離展 → 中央站取行李 → 優先 15:00–16:00 快車。最晚備案約 17:00，須選 20:15 前到站的聯程；指定日期班次仍待確認。</p></aside>}<div className="timeline">{[['上午',day.morning],['下午',day.afternoon],['晚上',day.evening]].map(([label,text])=><TimelineCard key={label} label={label} text={text}/>)}</div><section className="transport-card"><h3>交通 · 這樣走最快</h3><p>{day.transport}</p><div className="actions"><a href="https://int.bahn.de/en" target="_blank" rel="noreferrer">查 DB 車次 ↗</a><a href="https://www.ns.nl/en" target="_blank" rel="noreferrer">查 NS 車次 ↗</a><a href="https://9292.nl/en" target="_blank" rel="noreferrer">查荷蘭市區接駁 ↗</a></div></section><section className="meal-card"><h3>今天吃什麼</h3><p>{day.food}</p></section>{selected>='2026-11-17'&&selected<='2026-11-23'&&day.rain&&<div className="rain"><h3>荷蘭雨天走法</h3><p>{day.rain}</p></div>}<label className="note-label" htmlFor="day-note">當日備註 <span>本機暫存</span></label><Textarea id="day-note" disabled={!ready} value={draft.notes[selected]||''} placeholder="集合時間、餐點選擇、想調整的地方…" onChange={e=>update({...draft,notes:{...draft.notes,[selected]:e.target.value}})}/><p className="save-status" role="status">{message}</p><FoodCity city={foodCity}/></section></TabsContent>
 <TabsContent value="flights"><h2>5 人會合與往返航班</h2><p>按你確認的截圖：四位從松山出發，回程抵桃園；你僅搭浦東往返歐洲。全部為當地時間。</p><div className="flight-grid">{flights.map(f=><article key={f.group+f.route}><p className="eyebrow">{f.group}</p><h3>{f.route}</h3><p>{f.detail}</p></article>)}</div><aside className="deadline"><h3>去程需要換機場</h3><p>虹橋 SHA → 浦東 PVG，四位旅伴地面轉移後與你會合。不要把 5 小時 55 分全當候機時間；入境、行李、跨機場與再報到都在其中。</p></aside><h2>MEDICA 兩天交通</h2><div className="flight-grid"><article><h3>11/16 · 地鐵為主</h3><p>08:45–09:00 公寓出發 → Bilk → U72／U73 至 Heinrich-Heine-Allee → 換 U78 至 Messe Nord。門到門預留 50–65 分，10:00 開門。</p><p>17:15 左右整理離場；回程同路。若疲累再比較 UberXL，大型車不一定比地鐵快。</p></article><article><h3>11/17 · 行李先放中央站</h3><p>08:00 早餐退房 → Hbf 寄存 → U78 入場。13:30 離展 → Hbf 取行李，優先搭 15:00–16:00 最快聯程前往鹿特丹。</p><p>不要回 Bilk 取行李。置物櫃滿時使用事先確認的站旁寄存點，勿帶大箱進展館碰運氣。</p></article></div><h3>Uber 怎麼選</h3><p>5 人選 UberXL／大型計程車；一般 UberX 不夠坐。沒有 XL 就分 2 台。XL 可容納的乘客數不等於能放 5 件大箱，訂車時須核對行李容量。</p><p>平順時單程車程先抓 25–40 分，展期含等車與塞車留 45–70 分。只在 App 預計抵達比公共交通早，或需要少走路時選；不保證供車。預算已另留大型車／寄存額度。</p><h3>鹿特丹最晚搭哪班？</h3><p><strong>建議購票上限：17:00 左右出發，且整段預定 20:15 前抵 Rotterdam Centraal。</strong>目前查到的常態 ICE 122 約 17:11 僅作查票候選，未取得 2026/11/17 完整聯程確認，因此不能稱為當天確定的最後一班。主方案買 15:00–16:00 的快速聯程，保留錯過或取消時的後備。</p><p>若延誤預計會超過 21:00 才到站，立即由你們聯絡房東並查替代路線／住宿；不把尚未同意的晚到入住當備案。此處沒有代發任何訊息。</p><h2>仍需確認</h2><ul><li>5 人火車座位、Utrecht 轉乘、11/17 行李寄存容量與營業時間。</li><li>三間房源的正式入住資料；鹿特丹改 5 人價格與開放床房。</li><li>11/18 Humanitas Bergweg、11/20 Het AMSTELhuis 接待同意；目前尚未聯繫。</li><li>家人上海過夜，以及換機場行李與各航段報到截止。</li></ul></TabsContent>
 <TabsContent value="stays"><h2>新住宿 · 5 人分攤</h2><p><strong>本機暫存</strong>：只保存在這個瀏覽器。請匯出備份，才能讓其他裝置或 Claude 讀到修改。</p><div className="stay-grid">{draft.stays.map((s,i)=><section className="stay-form" key={i}><h3>{s.city}</h3><p>{s.checkIn} → {s.checkOut}</p>{stayLinks[i]&&<a href={stayLinks[i]} target="_blank" rel="noreferrer">開啟房源 ↗</a>}{(['name','address','booking'] as const).map(field=><label key={field}>{({name:'住宿名稱',address:'地址／附近地標',booking:'訂房備註'})[field]}<Textarea disabled={!ready} value={s[field]} onChange={e=>update({...draft,stays:draft.stays.map((v,j)=>i===j?{...v,[field]:e.target.value}:v)})}/></label>)}</section>)}</div><section className="exchange"><h2>與 Claude 共編</h2><ol><li>匯出 Markdown 供閱讀，或 JSON 供修改。</li><li>保留日期與欄位，請 Claude 回傳完整 JSON 再匯入。住宿文字編輯不會自動改動報價。</li><li>匯入前會先下載目前版本備份；不同裝置手動交換檔案。</li></ol><div className="actions"><Button disabled={!ready} onClick={()=>download('md')}>匯出 Markdown</Button><Button disabled={!ready} variant="outline" onClick={()=>download('json')}>匯出 JSON</Button><Button disabled={!ready} variant="outline" onClick={()=>fileRef.current?.click()}>匯入 JSON</Button><input ref={fileRef} type="file" accept=".json,application/json" hidden onChange={e=>void importFile(e.target.files?.[0])}/></div><p className="save-status" role="status">{message}</p></section></TabsContent>
 <TabsContent value="guide"><h2>每個城市 · 吃什麼、去哪買菜</h2><p>早餐與多數晚餐自煮，午餐外食。下列各家是候選，挑順路的即可。</p>{guide.map(g=><section className="city-section" key={g.city}><FoodCity city={g.city}/><div className="shopping"><h3>買菜安排</h3><p>{g.shopping}</p></div></section>)}</TabsContent>
 <TabsContent value="weather"><WeatherPanel/></TabsContent><TabsContent value="budget"><Budget/></TabsContent></Tabs><footer>2026 德荷旅遊手冊 · 5 人 · 11/17 鹿特丹 22:00 前入住<br/>車次與報價以指定日期查詢及正式訂單為準</footer></main>;
}
